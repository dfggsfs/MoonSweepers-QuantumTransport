<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuantumTransport</AssemblyName>
    <Version>0.7.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers</GameDir>
    <InteropDir Condition="'$(InteropDir)' == ''">$(GameDir)/Lustral/interop</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuantumTransport.Core/QuantumTransport.Core.csproj" />
    <Reference Include="Lustral.Api"><HintPath>$(GameDir)/Lustral/core/Lustral.Api.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)/Lustral/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameDir)/Lustral/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(GameDir)/Lustral/core/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(InteropDir)/*.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
